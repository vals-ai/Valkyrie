{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Valkyrie",
  "description": "Run scalable, reproducible evaluations for AI agents.",
  "colors": {
    "primary": "#386B46",
    "light": "#6FD09F",
    "dark": "#488959"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#F3F2F2",
      "dark": "#171717"
    }
  },
  "logo": {
    "light": "/images/vals-logo-light.svg",
    "dark": "/images/vals-logo-dark.svg"
  },
  "favicon": {
    "light": "/images/vals-icon-light.svg",
    "dark": "/images/vals-icon-dark.svg"
  },
  "fonts": {
    "heading": {
      "family": "Martina Plantijn",
      "source": "https://www.vals.ai/fonts/MartinaPlantijn/martina-plantijn-regular.woff2",
      "format": "woff2",
      "weight": 400
    },
    "body": {
      "family": "Söhne",
      "source": "https://www.vals.ai/fonts/Soehne/soehne-buch.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "get-started/quickstart",
          "get-started/hosting",
          "get-started/configuration",
          "get-started/sandbox-providers"
        ]
      },
      {
        "group": "Agents",
        "pages": [
          "agents/manage-agents",
          "agents/agent-contract"
        ]
      },
      {
        "group": "Runs",
        "pages": [
          "runs/start",
          "runs/monitor",
          "runs/manage",
          "runs/results-and-outputs",
          "runs/slack-notifications"
        ]
      },
      {
        "group": "Benchmarks",
        "pages": [
          "benchmarks/custom-services",
          "benchmarks/authentication"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/post-run-lambda",
          "integrations/docent"
        ]
      },
      {
        "group": "Python SDK",
        "pages": [
          "sdk/quickstart",
          "sdk/runs",
          "sdk/resources",
          "sdk/errors"
        ]
      },
      {
        "group": "CLI reference",
        "pages": {
          "$ref": "reference/cli/navigation.json"
        }
      },
      {
        "group": "Python SDK reference",
        "pages": {
          "$ref": "reference/sdk/navigation.json"
        }
      },
      {
        "group": "Self-hosting",
        "pages": [
          "self-hosting/infrastructure",
          "self-hosting/aws-permissions"
        ]
      }
    ]
  },
  "redirects": {
    "$ref": "reference/redirects.json"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/vals-ai/Valkyrie"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vals-ai/Valkyrie"
    }
  }
}
