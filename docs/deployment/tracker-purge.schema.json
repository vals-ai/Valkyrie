            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "verifier": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
            "title": "Verifier",
            "type": "string"
          },
          "evidence_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Evidence Sha256",
            "type": "string"
          },
          "confirmation": {
            "const": "all_inventory_hosts_terminated_and_old_claims_disabled",
