          "contract": {
            "const": "stable-host-lifecycle-v1",
            "title": "Contract",
            "type": "string"
          },
          "deployment_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Deployment Sha256",
            "type": "string"
          },
          "host_inventory": {
            "items": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Host Inventory",
            "type": "array",
            "uniqueItems": true
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "acknowledgement_required_since": {
            "format": "date-time",
            "title": "Acknowledgement Required Since",
            "type": "string"
          },
          "verifier": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
            "title": "Verifier",
            "type": "string"
          },
          "legacy_dispatch_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Legacy Dispatch Ids",
            "type": "array"
          }
        },
        "required": [
          "contract",
          "deployment_sha256",
          "host_inventory",
          "observed_at",
          "acknowledgement_required_since",
          "verifier"
        ],
        "title": "HostContractObservation",
        "type": "object"
      },
      "OperationIdentity": {
