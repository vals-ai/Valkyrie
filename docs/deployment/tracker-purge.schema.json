          "host_inventory": {
            "items": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
              "type": "string"
            },
            "title": "Host Inventory",
            "type": "array"
          },
          "deployed_host_contract": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
