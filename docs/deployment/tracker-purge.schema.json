          "s3_bucket": {
            "minLength": 1,
            "title": "S3 Bucket",
            "type": "string"
          },
          "log_group": {
            "title": "Log Group",
            "type": "string"
          },
          "log_retention_days": {
            "exclusiveMinimum": 0,
            "title": "Log Retention Days",
            "type": "integer"
          }
        },
        "required": [
          "region",
          "s3_bucket",
          "log_group",
          "log_retention_days"
        ],
        "title": "AWSResources",
        "type": "object"
