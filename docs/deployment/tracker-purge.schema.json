              {
                "type": "null"
              }
            ],
            "title": "Checksum Sha256"
          },
          "state": {
            "enum": [
              "version",
              "current_object",
              "current_delete_marker",
              "delete_marker"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "key",
          "source_version_id",
          "destination_version_id",
