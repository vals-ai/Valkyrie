          "provenance",
          "identity",
          "run_id",
          "hold_acquired_at",
          "dispatch_ids",
          "host_inventory",
          "deployed_host_contract",
          "observed_at",
          "verifier",
          "evidence_sha256",
          "confirmation"
        ],
        "title": "ExternalHostDrain",
        "type": "object"
      },
