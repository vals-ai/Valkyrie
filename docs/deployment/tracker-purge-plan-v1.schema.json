{
  "$defs": {
    "AWSResources": {
      "additionalProperties": false,
      "properties": {
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "s3_bucket": {
          "minLength": 1,
          "title": "S3 Bucket",
          "type": "string"
        },
        "log_group": {
          "title": "Log Group",
          "type": "string"
        },
        "log_retention_days": {
          "exclusiveMinimum": 0,
          "title": "Log Retention Days",
          "type": "integer"
        }
      },
      "required": [
        "region",
        "s3_bucket",
        "log_group",
        "log_retention_days"
      ],
      "title": "AWSResources",
      "type": "object"
    },
    "OperationIdentity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "parent_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Plan Sha256",
          "type": "string"
        },
        "github_owner_id": {
          "exclusiveMinimum": 0,
          "title": "Github Owner Id",
          "type": "integer"
        },
        "org_id": {
          "format": "uuid",
          "title": "Org Id",
          "type": "string"
        },
        "source_aws_account_id": {
          "pattern": "^[0-9]{12}$",
          "title": "Source Aws Account Id",
          "type": "string"
        },
        "destination_aws_account_id": {
          "pattern": "^[0-9]{12}$",
          "title": "Destination Aws Account Id",
          "type": "string"
        },
        "region": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
          "title": "Region",
          "type": "string"
        },
        "environment": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
          "title": "Environment",
          "type": "string"
        },
        "database_target": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
          "title": "Database Target",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Run Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "operation_id",
        "parent_plan_sha256",
        "github_owner_id",
        "org_id",
        "source_aws_account_id",
        "destination_aws_account_id",
        "region",
        "environment",
        "database_target",
        "run_ids"
      ],
      "title": "OperationIdentity",
      "type": "object"
    },
    "ProviderLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$",
          "title": "Kind",
          "type": "string"
        },
        "secret_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Secret Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "secret_name"
      ],
      "title": "ProviderLocator",
      "type": "object"
    },
    "PurgeRun": {
      "additionalProperties": false,
      "properties": {
        "expected_run_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Run Label"
        },
        "scope": {
          "$ref": "#/$defs/RunScope"
        },
        "provider": {
          "$ref": "#/$defs/ProviderLocator"
        },
        "released_relocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleasedRelocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scope",
        "provider"
      ],
      "title": "PurgeRun",
      "type": "object"
    },
    "ReleasedRelocation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        },
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "released_at": {
          "format": "date-time",
          "title": "Released At",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "identity_sha256",
        "scope_sha256",
        "acquired_at",
        "released_at"
      ],
      "title": "ReleasedRelocation",
      "type": "object"
    },
    "RunScope": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "original_resources": {
          "$ref": "#/$defs/AWSResources"
        },
        "object_prefix": {
          "default": "",
          "title": "Object Prefix",
          "type": "string"
        },
        "log_group": {
          "default": "",
          "title": "Log Group",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "original_resources"
      ],
      "title": "RunScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "identity": {
      "$ref": "#/$defs/OperationIdentity"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/PurgeRun"
      },
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "identity",
    "runs"
  ],
  "title": "PurgePlan",
  "type": "object"
}
