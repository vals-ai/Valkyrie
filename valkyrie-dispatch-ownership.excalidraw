      "height": 46,
      "strokeColor": "#1e1e1e",
      "text": "How one Executor run keeps its release",
      "fontSize": 36,
      "fontFamily": 2,
      "createdAt": "2026-07-21T00:32:38.753Z",
      "updatedAt": "2026-07-21T00:32:38.753Z",
      "version": 1
    },
    {
      "id": "d-subtitle",
      "type": "text",
      "x": 40,
      "y": 70,
      "width": 1410,
      "height": 32,
      "strokeColor": "#495057",
      "text": "Tracker saves the release in PostgreSQL before Redis delivers it. ExecutorHost claims the matching run, then starts the S3 package.",
      "fontSize": 22,
      "fontFamily": 2,
      "createdAt": "2026-07-21T00:32:38.753Z",
      "updatedAt": "2026-07-21T00:32:38.753Z",
