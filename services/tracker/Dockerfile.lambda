FROM public.ecr.aws/lambda/python:3.12

RUN dnf install -y git \
    && dnf clean all

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /bin/

WORKDIR ${LAMBDA_TASK_ROOT}

COPY pyproject.toml uv.lock ./

RUN uv export --locked --no-dev --no-emit-project --output-file requirements.txt \
    && uv pip install --system --requirements requirements.txt \
    && rm requirements.txt

COPY src/tracker ./tracker
COPY src/executor_protocol.py ./executor_protocol.py

CMD ["tracker.sandbox_cleanup.lambda_handler"]
