*
!.dockerignore
!services/
services/*
!services/executor_host/
services/executor_host/*
!services/executor_host/Dockerfile
!services/executor_host/__init__.py
!services/executor_host/observability.py
!services/executor_host/requirements.txt
!services/executor_host/supervisor.py
!services/tracker/
services/tracker/*
!services/tracker/src/
services/tracker/src/*
!services/tracker/src/executor_protocol.py
!services/tracker/src/tracker/
services/tracker/src/tracker/*
!services/tracker/src/tracker/__init__.py
!services/tracker/src/tracker/aws/
services/tracker/src/tracker/aws/*
!services/tracker/src/tracker/aws/__init__.py
!services/tracker/src/tracker/aws/executor_artifacts.py
!services/tracker/src/tracker/local/
services/tracker/src/tracker/local/*
!services/tracker/src/tracker/local/__init__.py
!services/tracker/src/tracker/local/executor_artifacts.py
!services/tracker/src/tracker/runtime/
services/tracker/src/tracker/runtime/*
!services/tracker/src/tracker/runtime/__init__.py
!services/tracker/src/tracker/runtime/executor_artifacts.py
!services/tracker/src/tracker/runtime/lifecycle.py
