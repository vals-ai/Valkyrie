    {
      "id": "ops-lifecycle",
      "type": "text",
      "x": 80,
      "y": 650,
      "width": 720,
      "height": 155,
      "strokeColor": "#9c6500",
      "text": "DRAIN + RETIRE\nCount active dispatches by release.\nRetire only DRAINING at zero.\nRetain artifact 30 days.\nDelete only with no queued / running references.",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-07-20T21:50:06.027Z",
      "updatedAt": "2026-07-20T21:50:06.027Z",
      "version": 1
    },
    {
      "id": "ops-failure",
      "type": "text",
      "x": 870,
      "y": 650,
      "width": 720,
      "height": 155,
      "strokeColor": "#a61e4d",
      "text": "TERMINAL RULES\nDuplicate claim → skip.\nNormal exit → FINISHED.\nLaunch / execution error → FAILED.\nUncertain terminal write / orphan → block retirement.",
      "fontSize": 24,
      "fontFamily": 2,
      "createdAt": "2026-07-20T21:50:06.027Z",
      "updatedAt": "2026-07-20T21:50:06.027Z",
      "version": 1
